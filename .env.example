# ==============================================================================
# QuantPilot Environment Configuration (.env.example)
#
# IMPORTANT:
# 1. Copy this file to '.env' and fill in your credentials.
# 2. Never commit '.env' with real secrets to version control.
# 3. Testnet-Only Guard: System refuses to start if TARGET_ENV is not 'testnet'.
# ==============================================================================

# Target Environment: must be 'testnet' (production hostnames are strictly rejected)
TARGET_ENV=testnet

# Delta Exchange Testnet REST & WebSocket Hostnames (India Testnet / Demo Account)
DELTA_REST_URL=https://cdn-ind.testnet.deltaex.org
DELTA_WS_PUBLIC_URL=wss://socket-ind-pub.testnet.deltaex.org
DELTA_WS_PRIVATE_URL=wss://socket-ind.testnet.deltaex.org

# Delta Exchange API Credentials (Testnet / Demo Account)
# Note: Keys with trading permission must have IP whitelisted in Delta Testnet Portal
DELTA_API_KEY=your_delta_testnet_api_key_here
DELTA_API_SECRET=your_delta_testnet_api_secret_here

# Control Plane Security: Shared secret required for state-changing endpoints
# Pass via header: 'X-Control-Secret: <token>'
CONTROL_PLANE_SECRET=change_me_to_a_secure_token

# Persistence: SQLite database file path
DATABASE_PATH=quantpilot.db

# Engine Configuration File (default or demo)
CONFIG_FILE=config/default.json

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Symbol Configuration
DEFAULT_SYMBOL=BTCUSD
